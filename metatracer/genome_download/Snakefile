"""GTDB representative annotation-availability workflow."""

configfile: "config.yaml"

OUT = config.get("output_dir", "results").rstrip("/")
RES = config.get("resource_dir", "resources").rstrip("/")
LOG = config.get("log_dir", "logs").rstrip("/")
DATASET_DIR = f"{RES}/ncbi_dataset"
DATASET_ZIP = f"{RES}/ncbi_dataset.zip"

DOMAIN_PREFIX = {"bacteria": "bac120", "archaea": "ar53"}
requested_domains = config.get("gtdb_domains", ["bacteria"])
if isinstance(requested_domains, str):
    requested_domains = [requested_domains]
requested_domains = [str(domain).lower() for domain in requested_domains]
unknown_domains = sorted(set(requested_domains) - set(DOMAIN_PREFIX))
if not requested_domains or unknown_domains:
    raise ValueError(
        "gtdb_domains must contain bacteria, archaea, or both; invalid values: "
        + ", ".join(unknown_domains)
    )
metadata_prefixes = [DOMAIN_PREFIX[domain] for domain in requested_domains]
metadata_tables = expand(f"{RES}/{{prefix}}_metadata.tsv", prefix=metadata_prefixes)

FINAL_OUTPUTS = [
    f"{OUT}/gtdb_representatives.tsv",
    f"{OUT}/gtdb_kept_accessions_metadata.tsv",
    f"{OUT}/gtdb_representative_accessions.txt",
    f"{OUT}/gtdb_representative_taxonomy.tsv",
    f"{OUT}/gtdb_accession_filter_summary.tsv",
    f"{OUT}/ncbi_datasets_file_inventory.tsv",
    f"{OUT}/supplementary_genome_manifest.tsv",
    f"{OUT}/gtdb_representatives_with_ncbi_annotation_status.tsv",
    f"{OUT}/summary_annotation_status.tsv",
    f"{OUT}/summary_by_genome_category.tsv",
    f"{OUT}/summary_by_gtdb_phylum.tsv",
    f"{OUT}/summary_by_gtdb_rank.tsv",
    f"{OUT}/summary_by_accession_prefix.tsv",
]


rule all:
    input:
        FINAL_OUTPUTS


rule download_gtdb_metadata:
    output:
        f"{RES}/{{prefix}}_metadata.tsv.gz"
    params:
        url=lambda wildcards: config["gtdb_metadata_urls"][wildcards.prefix]
    wildcard_constraints:
        prefix="bac120|ar53"
    log:
        f"{LOG}/download_gtdb_metadata_{{prefix}}.log"
    shell:
        """
        mkdir -p $(dirname {output:q}) $(dirname {log:q})
        curl -L --fail --retry 4 --retry-delay 10 {params.url:q} -o {output:q} \
          > {log:q} 2>&1
        """


rule decompress_gtdb_metadata:
    input:
        f"{RES}/{{prefix}}_metadata.tsv.gz"
    output:
        f"{RES}/{{prefix}}_metadata.tsv"
    wildcard_constraints:
        prefix="bac120|ar53"
    log:
        f"{LOG}/decompress_gtdb_metadata_{{prefix}}.log"
    shell:
        """
        gzip -cd {input:q} > {output:q} 2> {log:q}
        """


rule parse_gtdb_metadata:
    input:
        metadata_tables
    output:
        representatives=f"{OUT}/gtdb_representatives.tsv",
        kept=f"{OUT}/gtdb_kept_accessions_metadata.tsv",
        accessions=f"{OUT}/gtdb_representative_accessions.txt",
        taxonomy=f"{OUT}/gtdb_representative_taxonomy.tsv",
        summary=f"{OUT}/gtdb_accession_filter_summary.tsv",
    params:
        filters=config.get("accession_filters", {}),
        max_accessions=config.get("max_accessions"),
    conda:
        "envs/python.yaml"
    log:
        f"{LOG}/parse_gtdb_metadata.log"
    script:
        "scripts/parse_gtdb_metadata.py"


rule download_ncbi_dataset:
    input:
        f"{OUT}/gtdb_representative_accessions.txt"
    output:
        archive=DATASET_ZIP,
        status=f"{RES}/ncbi_dataset.status.json",
    params:
        include=config.get("datasets_include", "genome,gff3,protein"),
        attempts=config.get("datasets_download_attempts", 5),
        retry_delay=config.get("datasets_retry_delay_seconds", 30),
    conda:
        "envs/ncbi_datasets.yaml"
    log:
        f"{LOG}/download_ncbi_dataset.log"
    script:
        "scripts/download_ncbi_batch.py"


rule unpack_ncbi_dataset:
    input:
        archive=DATASET_ZIP,
        status=f"{RES}/ncbi_dataset.status.json",
    output:
        directory(DATASET_DIR)
    conda:
        "envs/python.yaml"
    log:
        f"{LOG}/unpack_ncbi_dataset.log"
    script:
        "scripts/unpack_ncbi_batch.py"


rule rehydrate_ncbi_dataset:
    input:
        dataset=DATASET_DIR,
        package_status=f"{RES}/ncbi_dataset.status.json",
    output:
        status=f"{RES}/ncbi_dataset.rehydrate.status.json",
    params:
        max_workers=config.get("rehydrate_max_workers", 10)
    conda:
        "envs/ncbi_datasets.yaml"
    log:
        f"{LOG}/rehydrate_ncbi_dataset.log"
    script:
        "scripts/rehydrate_ncbi_batch.py"


rule inventory_ncbi_dataset:
    input:
        accessions=f"{OUT}/gtdb_representative_accessions.txt",
        dataset=DATASET_DIR,
        package_status=f"{RES}/ncbi_dataset.status.json",
        rehydrate_status=f"{RES}/ncbi_dataset.rehydrate.status.json",
    output:
        f"{OUT}/ncbi_datasets_file_inventory.tsv"
    conda:
        "envs/python.yaml"
    log:
        f"{LOG}/inventory_ncbi_dataset.log"
    script:
        "scripts/inventory_ncbi_dataset.py"


rule build_supplementary_genome_manifest:
    input:
        metadata=f"{OUT}/gtdb_kept_accessions_metadata.tsv",
        inventory=f"{OUT}/ncbi_datasets_file_inventory.tsv",
        dataset=DATASET_DIR,
        rehydrate_status=f"{RES}/ncbi_dataset.rehydrate.status.json",
    output:
        f"{OUT}/supplementary_genome_manifest.tsv"
    conda:
        "envs/python.yaml"
    log:
        f"{LOG}/build_supplementary_genome_manifest.log"
    script:
        "scripts/build_supplementary_genome_manifest.py"

rule join_annotation_status:
    input:
        metadata=f"{OUT}/gtdb_kept_accessions_metadata.tsv",
        inventory=f"{OUT}/ncbi_datasets_file_inventory.tsv",
    output:
        f"{OUT}/gtdb_representatives_with_ncbi_annotation_status.tsv"
    conda:
        "envs/python.yaml"
    log:
        f"{LOG}/join_annotation_status.log"
    script:
        "scripts/join_annotation_status.py"


rule summarize_annotation_status:
    input:
        all_representatives=f"{OUT}/gtdb_representatives.tsv",
        filtered=f"{OUT}/gtdb_kept_accessions_metadata.tsv",
        joined=f"{OUT}/gtdb_representatives_with_ncbi_annotation_status.tsv",
    output:
        status=f"{OUT}/summary_annotation_status.tsv",
        category=f"{OUT}/summary_by_genome_category.tsv",
        phylum=f"{OUT}/summary_by_gtdb_phylum.tsv",
        rank=f"{OUT}/summary_by_gtdb_rank.tsv",
        prefix=f"{OUT}/summary_by_accession_prefix.tsv",
    conda:
        "envs/python.yaml"
    log:
        f"{LOG}/summarize_annotation_status.log"
    script:
        "scripts/summarize_annotation_status.py"
